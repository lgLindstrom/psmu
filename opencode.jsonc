{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "esp-idf": {
        "type": "local",
        "command": ["bash", ".opencode/esp-idf-mcp.sh"],
        "cwd": "."
      }
    }
  },
  "plugins": [
    "@dietrichgebert/ponytail"
  ],
  "skills": [
    "~/tools/awesome-esp-ai/skills",
    "~/tools/trailofbits-skills/plugins/modern-cpp/skills"
  ]
}
