menu "PSMD"

    choice PSMD_BOARD
        prompt "Board variant"
        default PSMD_BOARD_DEV
        help
            The board the firmware is built for. The development board is the
            ESP32-C6 bring-up board; the production board's pin map is open
            (GAP-02).

        config PSMD_BOARD_DEV
            bool "Development board (ESP32-C6, button and both LEDs)"
        config PSMD_BOARD_PRODUCTION
            bool "Production board (pin map open, does not build yet)"
    endchoice

endmenu
